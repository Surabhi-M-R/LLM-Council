# ============================================================
# Production Environment Configuration for AWS Deployment
# ============================================================
# Copy this to .env when deploying, or pass as environment
# variables in App Runner / ECS task definitions.

# ---- Provider Configuration ----
LLM_PROVIDER=openrouter
STORAGE_BACKEND=dynamodb

# ---- AWS Configuration ----
AWS_REGION=us-east-1

# ---- DynamoDB ----
DYNAMODB_TABLE_NAME=LLMCouncilConversations

# ---- Amazon Bedrock ----
BEDROCK_ENABLED=true
BEDROCK_REGION=us-east-1
BEDROCK_COUNCIL_MODELS=us.amazon.nova-pro-v1:0,us.amazon.nova-lite-v1:0,us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_CHAIRMAN_MODEL=us.amazon.nova-pro-v1:0

# ---- Amazon Cognito ----
COGNITO_ENABLED=true
COGNITO_USER_POOL_ID=us-east-1_YjhPxkgXo
COGNITO_APP_CLIENT_ID=38oi9lenc41g9c8gnibedf1ta0
COGNITO_REGION=us-east-1

# ---- Amazon CloudWatch ----
CLOUDWATCH_ENABLED=true
CLOUDWATCH_NAMESPACE=LLMCouncil
CLOUDWATCH_LOG_GROUP=/llm-council/api

# ---- X-Ray ----
XRAY_ENABLED=true

# ---- Deployment Domains ----
# AMPLIFY_DOMAIN=main.d1234567890.amplifyapp.com
# CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net
